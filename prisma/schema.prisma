model Document {
  id String @id @default(uuid())

  numero String @unique

  type DocumentType

  status DocumentStatus @default(BROUILLON)

  reference String?

  objet String?

  clientId Int

  client BusinessPartner @relation(fields: [clientId], references: [id],onDelete: Cascade,onUpdate: Cascade)

  dateDocument DateTime @default(now())

  dateValidite String?

  devise String? @default("MAD")

  notes String?

  conditions String?

  remise Float @default(0)

  ajustement Float @default(0)

  montantHT Float @default(0)

  montantTVA Float @default(0)

  montantTTC Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()

  items DocumentItem[]

  activity Activity[]
}

model DocumentItem {
  id String @id @default(uuid())

  documentId String
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade,onUpdate: Cascade)

  article String

  description String?

  quantite Float @default(1)

  prixUnitaire Float @default(0)

  taxe Float @default(0)

  remise Float @default(0)

  montantHT Float @default(0)

  montantTTC Float @default(0)

  createdAt DateTime @default(now())
}