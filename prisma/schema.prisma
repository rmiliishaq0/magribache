generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin { 
  id    String     @id @default(uuid()) 
  name String?
  password String
  email String? @unique
  phone String?
  address String?
  website String?
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
  logo String?
  profilIcon String?
  tasks Task[]
} 


model Task { 
  id    String     @id @default(uuid()) 
  name String
  description String?
  status String
  priority String
  dueDate DateTime
  projet String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
  adminId String
  admin Admin @relation(fields: [adminId], references: [id])
} 

model Client { 
  id String     @id @default(uuid()) 
  entreprise String
  téléphone String?
  email String? @unique
  catégories String?
  ICE String?
  identifiantFiscal String?
  ville String?
  pays String?
  actif String?
  documents Document[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
}

model Fournisseur {
  id String @id @default(uuid())

  fournisseur String
  email String? @unique
  téléphone String?
  ICE String?
  identifiantFiscal String?
  ville String?
  pays String?
  catégories String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()

  contacts ContactsFournisseur[]
}

model ContactsFournisseur {
  id String @id @default(uuid())

  name String
  title String?
  email String? @unique
  téléphone String?
  Fournisseur String?
  city String?
  country String?
  actif String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()

  fournisseurId String
  fournisseur Fournisseur @relation(fields: [fournisseurId], references: [id])
}

model Prospects {
    id String     @id @default(uuid())
    nom String
    prospect String?
    email String? @unique
    téléphone String?
    statut String?
    source String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt()
    localisation String?
}

model Contrats {
    id String     @id @default(uuid())
     sujet String?
     client String?
     modèleContrat String?
     dateDepart String?
     dateFin String?
     createdAt DateTime @default(now())
     updatedAt DateTime @updatedAt()
}

model Contacts {
    id String     @id @default(uuid())
    nom String
    civilité String?
    email String? @unique
    téléphone String?
    //entreprise String?
    ville String?
    pays String?
    actif String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt()
}

enum DocumentType {
  DEVIS
  FACTURE
}

enum DocumentStatus {
  BROUILLON
  ENVOYE
  PAYE
  ANNULE
}

model Document {
  id String @id @default(uuid())

  numero String @unique

  type DocumentType

  status DocumentStatus @default(BROUILLON)

  reference String?

  objet String?

  clientId String

  client Client @relation(fields: [clientId], references: [id])

  dateDocument DateTime @default(now())

  dateValidite String?

  devise String? @default("MAD")

  notes String?

  conditions String?

  remise Float @default(0)

  ajustement Float @default(0)

  montantHT Float @default(0)

  montantTVA Float @default(0)

  montantTTC Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()

  items DocumentItem[]
}

model DocumentItem {
  id String @id @default(uuid())

  documentId String
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  article String

  description String?

  quantite Float @default(1)

  prixUnitaire Float @default(0)

  taxe Float @default(0)

  remise Float @default(0)

  montantHT Float @default(0)

  montantTTC Float @default(0)

  createdAt DateTime @default(now())
}