generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
enum Currency {
  MAD
  EUR
  USD
}

model Admin {
  id           String   @id @default(uuid())
  name         String?
  password     String
  email        String?  @unique
  phone        String?
  address      String?
  website      String?
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  logo         String?
  profilIcon   String?
  titlesColor String @default("#D97706")
  tableFontColor String  @default("#ffffff")
  tableBgColor String  @default("#D97706")
  footerText   String?
  signature    String?
  ice          String?
  rc           String?
  fiscalId     String?
  patente      String?
  cnss         String?
  shareCapital String?
  watermark    String?
  documentSettings String?
  currency  Currency @default(MAD)
  tva Float @default(20)

  tasks        Task[]
}

model Task {
  id          String    @id @default(uuid())
  name        String
  description String?
  status      String
  priority    String
  dueDate     DateTime?
  projet      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  adminId     String
  admin       Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model BusinessPartner {
  reference      String          @unique
  status         PartnerStatus   @default(NEW)
  companyType    CompanyType     @default(INDIVIDUAL)
  companyName    String?
  email          String?         @unique
  phone          String?         @unique
  whatsapp       String?         @unique
  website        String?
  address        String?
  city           String?
  region         String?
  country        String?         @default("Maroc")
  ice            String?
  rc             String?
  ifNumber       String?
  activity       String?
  source         PartnerSource   @default(OTHER)
  priority       PartnerPriority @default(MEDIUM)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  fullName       String?
  type           PartnerType     @default(PROSPECT)
  id             Int             @id @default(autoincrement())
  nextFollowUpAt DateTime?
  activities     Activity[]
  documents      Document[]

  @@index([status])
}

model Activity {
  id         String           @id @default(cuid())
  entityType EntityType
  action     ActivityType
  note       String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  partnerId  Int?
  documentId Int?
  document   Document?        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  partner    BusinessPartner? @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  productId  Int?
  product    Product?         @relation(fields: [productId], references: [id], onDelete: Cascade)

  logs       ActivityLog[]

  @@index([partnerId])
}

model ActivityLog {
  id         String   @id @default(cuid())
  activityId String
  field      String
  oldValue   String?
  newValue   String?
  createdAt  DateTime @default(now())
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
}



model Document {
  id            Int            @id @default(autoincrement())
  type          DocumentType
  status        DocumentStatus @default(DRAFT)
  reference     String         @unique

  documentDate  DateTime       @default(now())
  notes         String?

  discount      Decimal        @default(0) @db.Decimal(15, 2)
  adjustment    Decimal        @default(0) @db.Decimal(15, 2)
  subtotal      Decimal        @default(0) @db.Decimal(15, 2)
  taxAmount     Decimal        @default(0) @db.Decimal(15, 2)
  totalAmount   Decimal        @default(0) @db.Decimal(15, 2)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  paymentMethod String?
  chequeNum     String?
  bank          String?

  clientId      Int
  paymentStatus PaymentStatus  @default(UNPAID)
  validUntil    DateTime?
  sentAt        DateTime?

  activity      Activity[]
  client        BusinessPartner @relation(fields: [clientId], references: [id])
  items         DocumentItem[]

  @@index([type])
  @@index([status])
  @@index([paymentStatus])
  @@index([clientId])
  @@index([documentDate])
}

model DocumentItem {
  id          Int      @id @default(autoincrement())
  product     String
  description String?
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  tax     Float    @default(0)
  //discount    Float    @default(0)
  //subtotal    Float    @default(0)
  //totalAmount Float    @default(0)

  createdAt   DateTime @default(now())

  documentId  Int
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

enum PartnerType {
  PROSPECT
  CLIENT
  ARCHIVED
}

enum CompanyType {
  INDIVIDUAL
  FARMER
  COMPANY
  RESELLER
  ADMINISTRATION
  ASSOCIATION
}

enum PartnerPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PartnerSource {
  PHONE
  WHATSAPP
  FACEBOOK
  INSTAGRAM
  WEBSITE
  TIKTOK
  LINKEDIN
  VISIT
  REFERRAL
  OTHER
}

enum PartnerStatus {
  NEW
  CONTACTED
  QUALIFIED
  QUOTE_TO_PREPARE
  QUOTE_SENT
  NEGOTIATION
  WON
  LOST
  FOLLOW_UP_LATER
  ACTIVE
  GOOD_CLIENT
  TO_MONITOR
  INACTIVE
  BLOCKED
}

enum ActivityType {
  CREATED
  UPDATED
  DELETED
  NOTE
  CALL
  EMAIL
  WHATSAPP
  MEETING
  STATUS_CHANGED
  PDF_GENERATED
  SENT
  PAYMENT_RECEIVED
  STARTED
  COMPLETED
}

enum DocumentType {
  DEVIS
  FACTURE
}

enum DocumentStatus {
  DRAFT
  SENT
  UNDER_NEGOTIATION
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED_TO_ORDER
  VALIDATED
  CANCELLED
  CLOSED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum EntityType {
  PARTNER
  DOCUMENT
  PRODUCTION
  DELIVERY
  INVENTORY
  PRODUCT
}



enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum ProductType {
  RAW_MATERIAL
  FINISHED_PRODUCT
  ACCESSORY
  CONSUMABLE
  SPARE_PART
}

enum StockUnit {
  PIECE
  M3
  METER
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}


model Product {
    id            Int            @id @default(autoincrement())

  reference           String        @unique
  name                String

  type                ProductType
  status              ProductStatus @default(ACTIVE)

  unit                StockUnit

  capacityM3          Decimal?      @db.Decimal(10, 2)
  dimensions          String?
  material            String?
  color               String?
  grammage            String?

  taxRate             Decimal       @default(20) @db.Decimal(5, 2)
  salePriceHT         Decimal?      @db.Decimal(12, 2)
  purchasePriceHT     Decimal?      @db.Decimal(12, 2)

  currentStock        Decimal       @default(0) @db.Decimal(14, 3)
  minimumStock        Decimal?      @db.Decimal(14, 3)
  maximumStock        Decimal?      @db.Decimal(14, 3)

  trackLot            Boolean       @default(false)
  trackSerialNumber   Boolean       @default(false)

  suppliers           SupplierProduct[]

  purchaseOrderLines  PurchaseOrderLine[]
  receiptLines        GoodsReceiptLine[]

  stockLots           StockLot[]
  stockMovements      StockMovement[]

  finishedUnits       FinishedProductUnit[]

  activity      Activity[]

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([type])
  @@index([status])
  @@index([name])
}

model Supplier {
    id            Int            @id @default(autoincrement())


  reference           String          @unique
  name                String

  status              SupplierStatus  @default(ACTIVE)

  contactName         String?
  phone               String?
  whatsapp             String?
  email               String?

  country             String?
  city                String?
  address             String?

  ice                 String?
  rc                  String?
  ifNumber            String?

  paymentTerms        String?
  currency            String         @default("MAD")
  deliveryDelayDays   Int?

  notes               String?

  products            SupplierProduct[]

  purchaseOrders      PurchaseOrder[]
  receipts            GoodsReceipt[]
  stockLots           StockLot[]

  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([name])
  @@index([status])
}

model SupplierProduct {
  id                  Int    @id @default(autoincrement())

  supplierId          Int
  supplier            Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  productId           Int
  product             Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  supplierReference   String?

  purchasePriceHT     Decimal?  @db.Decimal(12, 4)

  minimumOrderQty     Decimal?  @db.Decimal(14, 3)
  deliveryDelayDays   Int?

  isPreferred         Boolean   @default(false)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([supplierId, productId])
  @@index([productId])
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id            Int            @id @default(autoincrement())

  reference           String              @unique

  supplierId          Int
  supplier            Supplier            @relation(fields: [supplierId], references: [id])

  orderDate           DateTime            @default(now())
  expectedDate        DateTime?

  status              PurchaseOrderStatus @default(DRAFT)

  currency            String              @default("MAD")

  totalHT             Decimal             @default(0) @db.Decimal(12, 2)
  taxAmount           Decimal             @default(0) @db.Decimal(12, 2)
  totalTTC            Decimal             @default(0) @db.Decimal(12, 2)

  paymentTerms        String?
  notes               String?

  lines               PurchaseOrderLine[]
  receipts            GoodsReceipt[]

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([supplierId])
  @@index([status])
  @@index([orderDate])
}

model PurchaseOrderLine {
  id                  Int            @id @default(autoincrement())

  purchaseOrderId     Int
  purchaseOrder       PurchaseOrder    @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  productId           Int
  product             Product           @relation(fields: [productId], references: [id])

  designation         String
  specification       String?

  quantity            Decimal           @db.Decimal(14, 3)
  receivedQuantity    Decimal           @default(0) @db.Decimal(14, 3)

  unit                StockUnit

  unitPriceHT         Decimal           @db.Decimal(12, 4)
  taxRate             Decimal           @default(20) @db.Decimal(5, 2)

  totalHT             Decimal           @default(0) @db.Decimal(12, 2)
  taxAmount           Decimal           @default(0) @db.Decimal(12, 2)
  totalTTC            Decimal           @default(0) @db.Decimal(12, 2)

  receiptLines        GoodsReceiptLine[]

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([purchaseOrderId])
  @@index([productId])
}

enum GoodsReceiptStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model GoodsReceipt {
  id                  Int             @id @default(autoincrement())

  reference           String             @unique

  supplierId          Int
  supplier            Supplier           @relation(fields: [supplierId], references: [id])

  purchaseOrderId     Int
  purchaseOrder       PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])

  receiptDate         DateTime           @default(now())

  supplierDocumentRef String?

  status              GoodsReceiptStatus @default(DRAFT)

  notes               String?

  lines               GoodsReceiptLine[]

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([purchaseOrderId])
  @@index([supplierId])
  @@index([receiptDate])
}

model GoodsReceiptLine {
  id                    Int             @id @default(autoincrement())

  goodsReceiptId        Int
  goodsReceipt          GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)

  purchaseOrderLineId   Int
  purchaseOrderLine     PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])

  productId             Int
  product               Product            @relation(fields: [productId], references: [id])

  quantityReceived      Decimal            @db.Decimal(14, 3)
  unit                  StockUnit

  unitPriceHT           Decimal?           @db.Decimal(12, 4)

  lotNumber             String?

  qualityChecked        Boolean            @default(false)
  qualityStatus         String?

  notes                 String?

  createdAt             DateTime           @default(now())

  @@index([goodsReceiptId])
  @@index([productId])
}

model StockLot {
  id                  Int       @id @default(autoincrement())

  lotNumber           String       @unique

  productId           Int
  product             Product      @relation(fields: [productId], references: [id])

  supplierId          Int?
  supplier            Supplier?    @relation(fields: [supplierId], references: [id])

  goodsReceiptId      Int?

  entryDate           DateTime     @default(now())

  quantityInitial     Decimal      @db.Decimal(14, 3)
  quantityAvailable   Decimal      @db.Decimal(14, 3)

  unit                StockUnit

  unitCost            Decimal?     @db.Decimal(12, 4)
  totalCost           Decimal?     @db.Decimal(14, 2)

  expiryDate          DateTime?

  isBlocked           Boolean      @default(false)

  movements            StockMovement[]

  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([productId, entryDate])
  @@index([supplierId])
}

enum StockMovementType {
  PURCHASE_IN
  PRODUCTION_OUT
  PRODUCTION_IN
  RETURN_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

model StockMovement {
  id                  Int             @id @default(autoincrement())

  reference           String             @unique

  productId           Int
  product             Product            @relation(fields: [productId], references: [id])

  stockLotId          Int?
  stockLot            StockLot?          @relation(fields: [stockLotId], references: [id])

  type                StockMovementType

  quantity            Decimal            @db.Decimal(14, 3)
  unit                StockUnit

  unitCost             Decimal?          @db.Decimal(12, 4)
  totalCost            Decimal?          @db.Decimal(14, 2)

  sourceType          String?
  sourceId            String?
  sourceReference     String?

  notes               String?

  createdAt            DateTime          @default(now())

  @@index([productId])
  @@index([stockLotId])
  @@index([type])
  @@index([createdAt])
}

enum FinishedProductUnitStatus {
  AVAILABLE
  RESERVED
  READY_TO_DELIVER
  IN_DELIVERY
  DELIVERED
  RETURNED
  SAV
  BLOCKED
}

model FinishedProductUnit {
  id                  Int                    @id @default(autoincrement())

  serialNumber        String                    @unique

  productId           Int
  product             Product                   @relation(fields: [productId], references: [id])

  status              FinishedProductUnitStatus @default(AVAILABLE)

  productionOrderId   Int?

  qualityStatus       String?

  entryDate           DateTime                  @default(now())
  deliveryDate        DateTime?

  notes               String?

  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([productId])
  @@index([serialNumber])
  @@index([status])
}