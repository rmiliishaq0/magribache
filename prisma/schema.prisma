generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PartnerType {
  PROSPECT
  CLIENT
  ARCHIVED
}

enum CompanyType {
  INDIVIDUAL
  FARMER
  COMPANY
  RESELLER
  ADMINISTRATION
  ASSOCIATION
}

enum PartnerPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PartnerSource {
  PHONE
  WHATSAPP
  FACEBOOK
  INSTAGRAM
  WEBSITE
  TIKTOK
  LINKEDIN
  VISIT
  REFERRAL
  OTHER
}
enum PartnerStatus {
  //prospect
  NEW
  CONTACTED
  QUALIFIED
  QUOTE_TO_PREPARE
  QUOTE_SENT
  NEGOTIATION
  WON
  LOST
  FOLLOW_UP_LATER
  //CLIENT
  ACTIVE
  GOOD_CLIENT
  TO_MONITOR
  INACTIVE
  BLOCKED
}

enum ActivityType {
  CREATED
  UPDATED
  DELETED

  NOTE

  CALL
  EMAIL
  WHATSAPP
  MEETING

  STATUS_CHANGED

  PDF_GENERATED
  SENT

  PAYMENT_RECEIVED

  STARTED
  COMPLETED
}

enum DocumentType {
  DEVIS
  FACTURE
}

enum DocumentStatus {
  BROUILLON
  ENVOYE
  PAYE
  ANNULE
}

enum EntityType {
  PARTNER
  DOCUMENT
  PRODUCTION
  DELIVERY
  INVENTORY
  PRODUCT
}


model Admin { 
  id    String     @id @default(uuid()) 
  name String?
  password String
  email String? @unique
  phone String?
  address String?
  website String?
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
  logo String?
  profilIcon String?
  signature String?
  defaultColor String?
  footerText String?
  tasks Task[]
} 


model Task { 
  id    String     @id @default(uuid()) 
  name String
  description String?
  status String
  priority String
  dueDate DateTime?
  projet String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
  adminId String
  admin Admin @relation(fields: [adminId], references: [id],onDelete: Cascade,onUpdate: Cascade)
} 


